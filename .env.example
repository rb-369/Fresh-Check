# FreshCheck Backend Environment Configuration
# ============================================

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=

# Optional: MongoDB Database Name (defaults to 'freshcheck')
MONGO_DB_NAME=freshcheck

# Cloudinary Storage Configuration
# Find these in your Cloudinary Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alternatively, you can use the single CLOUDINARY_URL string:
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
