# FreshCheck Vercel Deployment Environment Variables
# ==================================================
# When deploying to Vercel, set VITE_API_BASE_URL to your public HTTPS tunnel URL
# (e.g. from Cloudflare Tunnel, ngrok, or Pinggy).
# Note: You can also leave this empty and set/change it live in the web app UI anytime!
VITE_API_BASE_URL=https://your-tunnel-subdomain.trycloudflare.com
